<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lite" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Тёмный фон сразу при старте (без белой вспышки); «сияние» дорисовывается в коде одной картинкой -->
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorAccent">#FF7AA2FF</item>
        <item name="android:colorPrimary">#FF0E1424</item>
        <item name="android:colorPrimaryDark">#FF05070D</item>
        <item name="android:alertDialogTheme">@android:style/Theme.Material.Dialog.Alert</item>
    </style>
</resources>
